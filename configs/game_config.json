{
  // options: "spires" (endless procedural world - spiky hills + rare thousand-tile spires, Levels/spires.json) | "start" | "hill" | "arena" | "plain" | "gauntlet" (left-to-right combat run) | "sandbox" (one Template enemy — see Entities/Enemies/Types/TemplateEnemy.cs) | "aspid" (Primal-Aspid fight room, respawning waves of 3) | "training" | "warden" (armored walker demo) | "wizard" (caster: orb waves + pillars) | "weights" (knockback-by-mass rows: passive balls left, melee sparrers right, 0.3 → 40) | "flat" | "corridor" (bumpy tunnel) | "gym" (1-high ledges, CorrectorScenario applies)
  // entity options: aspid, wizard
  "Stage": "aspid",
  "WindowWidth": 1000,
  "WindowHeight": 900,
  "Fullscreen": true,
  "DebugDrawHitboxes":          true,
  "DebugDrawHurtboxes":         true,
  "DebugDrawPlayerOrientation": false,
  "DebugDrawBodies":            false,
  "DrawBackground":             true,
  "BackgroundStyle":            "trees", //trees / mountain
  "DrawPlayerSprites":          false, 
  "DrawPlayerSpriteSkin":       false, 
  "AnimationRig":               "biped", // "biped" for the plain stick rig (pumpkin_man_downsampled skin); "biped_rabbit" for the strutted rig + rabbit/badger skins
  // "PlayerSpriteBinding":        "pumpkin_man_downsampled",
  "PlayerSpriteBindings":       ["rabbit"], // rabbit/badger bindings need AnimationRig biped_rabbit; ["pumpkin_man_downsampled"] with AnimationRig biped
  "DebugDrawSkeleton":          true,
  "RunAnimationSolver":         true,
  "CameraZoom":                 5.0,
  "DebugDrawConstraints":       false, 
  "DebugDrawGuidedPath":        false,
  "DebugDrawCorrectorReference": false,
  "DebugDrawCorrectorBallistic": false,
  "DebugDrawCorrectorSolved":    false,
  "DebugDrawCObstacles":         false,
  // Physics-debug overlays whose CODE defaults are true — listed here so normal play
  // boots clean and flipping them is a config edit, not a code hunt:
  "DebugDrawCoast":              false, // aqua ballistic coast rollout + clearance rows
  "DebugDrawStepPlanner":        true, // planned foot targets/treads overlay
  "DebugDrawCorrectorContacts":  false, // contact points + impulse (dv) arrows
  "DebugDrawCorridor":           false, // corridor probe scan
  "DebugDrawHealthBars":        false,
  "DebugDrawForceFields":       false,
  "MouseTrail": true,
  "DebugDrawPrimitiveDemo": false,
  "DebugDrawDensityDemo": false,
  "DebugDrawMetaballDemo": false,
  "DebugDrawGlowDemo": false,
  "SpawnSecondPlayer": false,
  "SecondPlayerOffsetX": 96,
  "SecondPlayerOffsetY": 0,
  "TimeScale": 1.0
