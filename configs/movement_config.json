  "WalkAccel": 1800,
  "MaxWalkSpeed": 60,
  "CrouchMaxWalkSpeed": 30,
  "RunJumpMinSpeed": 48,
  "ArcJumpRunSpeed": 30,
  "MantleMaxEntrySpeed": 36,
  "FastSlideTerminalSpeed": 160,
  // Block peel (Shift+LMB grab) — see MovementConfig for each knob's role. Hot-reloads.
  // false restores the legacy one-frame drag-rip.
  "BlockPeelEnabled": true,
  // PeelKernelSigma is omitted on purpose: it decides how many TILES come away from a
  // grab, so it must track tile size, and the code default (0.7 * Chunk.TileSize in
  // MovementConfig.cs) does that. The old 11.2 literal here was a frozen 0.7*16.
  "PeelTetherRate": 3.0,
  "PeelJoinThreshold": 0.25,
  "PeelSpringCoeff": 4,
  "PeelSpringPower": 1.5,
  "PeelSpringMax": 60,
  "PeelTetherWear": 0.05,
  "PeelGlueWear": 0.4,
  "PeelGlueFloor": 0.15,
  "PeelGlueCore": 0.5,
  "PeelCrossMaterialEdge": 0.2,
  "PeelWeightStone": 3.0,
  "PeelWeightDirt": 1.5,
  "PeelWeightSand": 0.8,
  "PeelWeightFoam": 0.4,
  // Carried orb bleeds to nothing over this many seconds (8: buffed 4x from 2, 2026-11-04).
  "GrabDissipateSeconds": 8.0,
  // Block throw (Plans/BLOCK_THROW_PLAN.md §5): held reach (clod follows the cursor out
  // to this many px from the body), ball tracker, detach.
  "GrabHoldReach": 64,
  "GrabBallSmoothTime": 0.08,
  "GrabChaseSmoothTime": 0.05,
  "GrabBallMaxSpeed": 800,
  "GrabCatchSpeed": 40,
  "GrabChaseMaxSeconds": 0.25,
  "GrabSwipeSmoothing": 0.35,
  "GrabPointMaxSeconds": 0.25,
  // Launch decay (Physics/Launch.cs), px/s² on top of gravity + drag. Coast distance
  // from speed v is v²/(2·decay). 0 = off (plain knockback velocity).
  "WhipKickLaunchDecay": 400,
  "ThrowLaunchDecay": 1500,
  "ThrowLaunchBounce": 0.7,
  // Stab striker: heavy + slow ⇒ target Δv → (1+e)·speed, a built-in cap. Speed must
  // stay above ~215 to keep stunning (dv line 210). Launch: low decay, 4× wall-break mass.
  "StabStrikeSpeed": 380,
  "StabStrikeMassScale": 8,
  "StabRestitution": 0.1,
  "StabMinLaunch": 60,
  "StabLaunchDecay": 100,
  "StabLaunchImpactMass": 4,
  "StabLaunchBounce": 0.4
}