{
  // Per-tile-type strength. See World/MaterialStrengths.cs for load semantics.
  // Keys are TileType enum names (case-insensitive). MaxHP is in the same
  // TileMaxHP-multiple units as the legacy switch:
  //   Sand 0.5 — crumbles fast
  //   Dirt 1.0 — baseline (one full slash breaks it)
  //   Stone 2.0 — needs multiple slashes
  //   Foam 0.5 — cheap throwaway, also decays back to Empty after FoamLifetime

  // MaxHP is deliberately NOT rescaled for the 11px grid: World/CombatSystem.cs applies
  // the FULL hit damage to every overlapped cell rather than splitting it, so a fixed-px
  // hitbox now covering 2.116x more cells already carves the same physical area per hit.
  // Scaling MaxHP here would double-count that.

  // BuildCost is meter units per placed tile (see Character/BuildMeters.cs). Only
  // roughly correlated with MaxHP — foam is dirt-cheap because it evaporates, stone is
  // dear because it lasts. Each cost was DIVIDED by (16/11)² = 2.116 when the tile grid
  // went from 16px to 11px: the same physical wall is now 2.116x more tiles, so the
  // per-tile price has to drop by that factor to keep the build economy where it was.
  // At the move meter's refill rate stone now lands ~8.5 tiles/sec — the same physical
  // area per second as the old ~4/sec at 16px tiles.
  "Stone": { "MaxHP": 12.0, "BuildCost": 1.94  },
  "Dirt":  { "MaxHP": 2.0, "BuildCost": 0.77  },
  "Sand":  { "MaxHP": 0.5, "BuildCost": 0.44  },
  "Foam":  { "MaxHP": 0.5, "BuildCost": 0.12 },

  // Hardened rock — bedrock-grade, 10x stone. Not player-placeable (so BuildCost is
  // unreachable; the absurd value is a tripwire, not a price) and refused outright by
  // the block grab. Authored into levels with 'H'; terrain gen never emits it.
  "Hardened": { "MaxHP": 120.0, "BuildCost": 1000000.0 }
}
