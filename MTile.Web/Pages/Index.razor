@page "/"
@page "/index.html"
@inject IJSRuntime JsRuntime
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components
@using nkast.Wasm.Canvas

<PageTitle>MTile</PageTitle>

<div id="canvasHolder" style="
    background: #000;
    margin:0%;
    position: fixed;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    width:100vw;
    height:100vh;
">
    <canvas id="theCanvas" style="touch-action:none;"></canvas>
</div>

@if (_phase == Phase.Playing && !_bootDone)
{
    <div class="mtile-lobby">
        <div class="mtile-panel">
            <h1>MTile</h1>
            <p class="mtile-hint">Loading&hellip; first boot takes a few seconds
               (the tab may briefly freeze — that's normal).</p>
        </div>
    </div>
}

@if (_phase == Phase.Playing && _bootDone && _peerLost && !_overlayDismissed)
{
    <div class="mtile-overlay">
        <div class="mtile-panel mtile-overlay-panel">
            <h2 class="mtile-bad">The other player disconnected</h2>
            <p class="mtile-hint">Your @PeerNoun's connection closed, so the match can't continue.
               Reload to return to the lobby and start a new one.</p>
            <div class="mtile-row">
                <a class="mtile-btn" href="">Back to lobby</a>
                <button class="mtile-btn mtile-btn-quiet" @onclick="DismissOverlay">Dismiss</button>
            </div>
        </div>
    </div>
}
else if (_phase == Phase.Playing && _bootDone && _peerInterrupted && !_peerLost)
{
    <div class="mtile-banner">Connection to the other player interrupted &mdash; trying to recover&hellip;</div>
}

@if (_phase != Phase.Playing)
{
    <div class="mtile-lobby">
        <div class="mtile-panel">
            <h1>MTile</h1>

            @switch (_phase)
            {
                case Phase.Menu:
                    <h2>Stage</h2>
                    <div class="mtile-stages">
                        @foreach (var st in LobbyStages.All)
                        {
                            var pick = st;
                            <button class="mtile-stage @(pick.Name == _stage ? "mtile-stage-on" : "")"
                                    aria-pressed="@(pick.Name == _stage ? "true" : "false")"
                                    @onclick="() => _stage = pick.Name">
                                <span class="mtile-stage-name">@pick.Label</span>
                                <span class="mtile-tag @(pick.Coop ? "mtile-tag-coop" : "")">@(pick.Coop ? "co-op" : "versus")</span>
                                <span class="mtile-stage-blurb">@pick.Blurb</span>
                            </button>
                        }
                    </div>
                    <p class="mtile-hint">
                        @if (IsCoop)
                        {
                            <text>Play it solo, or host / join to team up with a partner. </text>
                        }
                        else
                        {
                            <text>Play it solo, or host / join a two-player match. </text>
                        }
                        The host picks the stage; matches connect peer-to-peer.
                    </p>
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="StartSolo">Solo</button>
                        @if (_signalReady)
                        {
                            <button class="mtile-btn" @onclick="StartHost">Host</button>
                            <button class="mtile-btn" @onclick="ChooseJoinCode">Join</button>
                        }
                    </div>
                    @if (!_signalReady)
                    {
                        <p class="mtile-hint">Room codes are unavailable (no Firebase config) —
                           use the manual blob exchange: copy one blob each way, no server.</p>
                    }
                    <div class="mtile-row">
                        <button class="mtile-btn mtile-btn-quiet" @onclick="StartHostManual">Host (manual)</button>
                        <button class="mtile-btn mtile-btn-quiet" @onclick="ChooseJoinManual">Join (manual)</button>
                    </div>
                    break;

                case Phase.HostGathering:
                    <p class="mtile-hint">Gathering network candidates&hellip;</p>
                    break;

                case Phase.HostShowCode:
                    @StageLine
                    <h2>Room code</h2>
                    <div class="mtile-code">@_roomCode</div>
                    <p class="mtile-hint">Send the code (or the invite link) to your @PeerNoun.
                       Waiting for them to join&hellip;</p>
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="() => Copy(JoinUrl)">Copy invite link</button>
                        <button class="mtile-btn" @onclick="() => Copy(_roomCode)">Copy code</button>
                        <button class="mtile-btn mtile-btn-quiet" @onclick="BackToMenu">Cancel</button>
                    </div>
                    break;

                case Phase.JoinEnterCode:
                    <h2>Enter the host's room code</h2>
                    <input class="mtile-codein" @bind="_enteredCode" @bind:event="oninput"
                           maxlength="8" spellcheck="false" autocapitalize="characters"
                           placeholder="e.g. K7Q2M" />
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="JoinWithCode">Join</button>
                        <button class="mtile-btn mtile-btn-quiet" @onclick="BackToMenu">Cancel</button>
                    </div>
                    break;

                case Phase.HostShowOffer:
                    @StageLine
                    <h2>1. Send this offer to your @PeerNoun</h2>
                    <textarea class="mtile-blob" readonly>@_offerBlob</textarea>
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="() => Copy(_offerBlob)">Copy offer</button>
                    </div>

                    <h2>2. Paste their answer here</h2>
                    <textarea class="mtile-blob" @bind="_pastedAnswer" @bind:event="oninput"
                              placeholder="paste the answer blob"></textarea>
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="HostConnect">Connect</button>
                        <button class="mtile-btn mtile-btn-quiet" @onclick="BackToMenu">Cancel</button>
                    </div>
                    break;

                case Phase.JoinPasteOffer:
                    <h2>1. Paste the host's offer</h2>
                    <textarea class="mtile-blob" @bind="_pastedOffer" @bind:event="oninput"
                              placeholder="paste the offer blob"></textarea>
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="JoinCreateAnswer">Create answer</button>
                        <button class="mtile-btn mtile-btn-quiet" @onclick="BackToMenu">Cancel</button>
                    </div>
                    break;

                case Phase.JoinShowAnswer:
                    @StageLine
                    <h2>2. Send this answer back to the host</h2>
                    <textarea class="mtile-blob" readonly>@_answerBlob</textarea>
                    <div class="mtile-row">
                        <button class="mtile-btn" @onclick="() => Copy(_answerBlob)">Copy answer</button>
                    </div>
                    <p class="mtile-hint">Waiting for the host&hellip;</p>
                    break;

                case Phase.Connecting:
                    @if (_isHost || _stageKnown) { @StageLine }
                    <p class="mtile-hint">Connecting&hellip;</p>
                    break;

                case Phase.Handshaking:
                    @StageLine
                    <p class="mtile-hint">Connected &mdash; agreeing on match settings&hellip;</p>
                    break;

                case Phase.Failed:
                    <h2 class="mtile-bad">@_failTitle</h2>
                    <pre class="mtile-error">@_error</pre>
                    <div class="mtile-row">
                        <a class="mtile-btn" href="">Reload</a>
                    </div>
                    break;
            }

            @if (_phase != Phase.Failed && !string.IsNullOrEmpty(_error))
            {
                <p class="mtile-bad">@_error</p>
            }
        </div>
    </div>
}

@code {
    // Read-only "which level" line: what the host picked, as the joiner sees it.
    private RenderFragment StageLine => __builder =>
    {
        <p class="mtile-stageline">Stage: <strong>@StageLabel</strong>
            <span class="mtile-tag @(IsCoop ? "mtile-tag-coop" : "")">@(IsCoop ? "co-op" : "versus")</span>
            @if (!_isHost) { <span class="mtile-hint"> &middot; chosen by the host</span> }
        </p>
    };
}

<style>
    .mtile-lobby {
        position: fixed; inset: 0; z-index: 10;
        background: #111; color: #eee;
        font-family: system-ui, sans-serif;
        display: flex; align-items: center; justify-content: center;
        overflow: auto;
    }
    .mtile-panel { width: min(46rem, 92vw); padding: 1.5rem 0; }
    .mtile-panel h1 { margin: 0 0 0.75rem 0; font-size: 2rem; letter-spacing: 0.06em; }
    .mtile-panel h2 { margin: 1.1rem 0 0.4rem 0; font-size: 0.95rem; font-weight: 600; color: #9cf; }
    .mtile-hint { color: #999; font-size: 0.9rem; line-height: 1.4; margin: 0.5rem 0; }
    .mtile-row { display: flex; gap: 0.6rem; margin: 0.6rem 0; flex-wrap: wrap; }
    .mtile-btn {
        background: #222; color: #eee; border: 1px solid #444; border-radius: 4px;
        padding: 0.5rem 1.1rem; font: inherit; font-size: 0.95rem; cursor: pointer;
        text-decoration: none; display: inline-block;
    }
    .mtile-btn:hover { background: #2c2c2c; border-color: #666; }
    .mtile-btn-quiet { color: #999; }
    .mtile-blob {
        width: 100%; height: 7rem; box-sizing: border-box; resize: vertical;
        background: #1b1b1b; color: #ddd; border: 1px solid #333; border-radius: 4px;
        padding: 0.5rem; font-family: ui-monospace, monospace; font-size: 0.75rem;
        word-break: break-all;
    }
    .mtile-code {
        font: 700 2.4rem ui-monospace, monospace; letter-spacing: 0.35em;
        color: #9cf; margin: 0.4rem 0; user-select: all;
    }
    .mtile-codein {
        width: 12rem; box-sizing: border-box; text-transform: uppercase;
        background: #1b1b1b; color: #ddd; border: 1px solid #333; border-radius: 4px;
        padding: 0.5rem; font-family: ui-monospace, monospace; font-size: 1.2rem;
        letter-spacing: 0.2em;
    }
    .mtile-bad, .mtile-panel h2.mtile-bad { color: #f77; }
    .mtile-stages { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 0.5rem; }
    .mtile-stage {
        text-align: left; background: #1b1b1b; color: #eee; border: 1px solid #333;
        border-radius: 4px; padding: 0.55rem 0.7rem; font: inherit; cursor: pointer;
    }
    .mtile-stage:hover { border-color: #666; }
    .mtile-stage-on { border-color: #9cf; background: #1d2630; }
    .mtile-stage-name { font-weight: 600; margin-right: 0.4rem; }
    .mtile-stage-blurb { display: block; color: #999; font-size: 0.8rem; margin-top: 0.25rem; }
    .mtile-tag {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
        border: 1px solid #a86; color: #fc9; border-radius: 3px; padding: 0 0.3rem;
    }
    .mtile-tag-coop { border-color: #6a8; color: #9fc; }
    .mtile-stageline { margin: 0.4rem 0; }
    .mtile-overlay {
        position: fixed; inset: 0; z-index: 20; background: rgba(0, 0, 0, 0.72); color: #eee;
        font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center;
    }
    .mtile-overlay-panel { background: #161616; border: 1px solid #333; border-radius: 6px; padding: 1.2rem 1.4rem; }
    .mtile-banner {
        position: fixed; top: 0.6rem; left: 50%; transform: translateX(-50%); z-index: 20;
        background: rgba(40, 30, 10, 0.9); color: #fc9; border: 1px solid #a86; border-radius: 4px;
        padding: 0.35rem 0.8rem; font: 0.85rem system-ui, sans-serif;
    }
    .mtile-error {
        white-space: pre-wrap; word-break: break-word; color: #f99;
        background: #1b1b1b; border: 1px solid #333; border-radius: 4px;
        padding: 0.6rem; max-height: 40vh; overflow: auto; font-size: 0.75rem;
    }
</style>
