
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/Mac/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

# macOS build of the game's content, selected by an OS condition in
# MTile.Desktop.csproj. Identical to Content.mgcb minus the .fx shaders: MonoGame's
# effect compiler (mgfxc) is a Windows binary and needs a Wine prefix to run on
# macOS/Linux, so a Mac without one fails the whole content build on CapsuleSplat.fx.
#
# Dropping them is safe because the only consumer is SkeletonMetaballRenderer via
# DevDemoRenderer.DrawMetaballDemo — a dev preview that game_config.json leaves off.
# Game1.LoadContent tolerates the missing .xnb and leaves _metaballs null.
#
# If the shaders ever reach the real render path, this file stops being sufficient:
# set up Wine (MonoGame's mgfxc_wine_setup.sh) and point the Mac build back at
# Content.mgcb. Same rationale as Content.Demo.mgcb.
#
# The GENERATED SOUNDS region below is maintained by scripts/sync-sounds.ps1, which
# writes this file and Content.mgcb from the same clip scan — don't hand-edit it.

#begin DebugFont.Mac.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
# Built under the name "DebugFont" so Content.Load<SpriteFont>("DebugFont") is
# unchanged; see the header of DebugFont.Mac.spritefont for why macOS needs its own.
/build:DebugFont.Mac.spritefont;DebugFont

#--------------------------- GENERATED SOUNDS -------------------------------#
