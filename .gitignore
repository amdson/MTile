.vscode
.config
# Claude Code: share skills with the repo, keep local settings/worktrees out
.claude/*
!.claude/skills/

/reference_art
# Build output — every project's bin/obj, plus Content's intermediate obj/
**/bin/
**/obj/

# MTile.Web stages a copy of the game assets into its own wwwroot/ at build time
# so the Blazor WASM dev server can serve them. The originals live at repo root.
MTile.Web/wwwroot/game_config.json
MTile.Web/wwwroot/movement_config.json
MTile.Web/wwwroot/impact_profiles.json
MTile.Web/wwwroot/material_strengths.json
MTile.Web/wwwroot/anim_solver_config.json
MTile.Web/wwwroot/Assets/
MTile.Web/wwwroot/SpriteBindings/
MTile.Web/wwwroot/Levels/
MTile.Web/wwwroot/ReferenceClips/
MTile.Web/wwwroot/SkeletonStates/
MTile.Web/wwwroot/Skeletons/
MTile.Web/wwwroot/Content/

# Local sim CSVs the tests dump on run — regenerated each test run.
MTile.Tests/*.csv

# Dev screenshots (F12 / MTILE_SCREENSHOT capture).
screenshot_*.png
_shot_*.png

# Motion-probe inspection output (dev tool)
.probe/

# Recorded gameplay takes (Ctrl+S in the recorder; opened via MTile.Demo -- --load)
Takes/

# Audio *sources* — licensed third-party bundles and raw/unsliced working material.
# The Sonniss GDC bundles are royalty-free to USE in a shipped game but NOT to
# REDISTRIBUTE, and this repo is public and deployed. Multi-GB besides.
# Only the built, game-ready Assets/Sounds/*.ogg belongs in git.
Assets/Sounds/*.zip
Audio/candidates/
Audio/raw/
SkeletonStates/.editor_view.json
